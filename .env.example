# SaaS Cardápio — Pizzaria v5
# Arquitetura: Cloudflare Pages (hosting) + Firebase (Auth + Firestore)
#
# ⚠️  NUNCA commite este arquivo com valores reais.
#     Copie para .env e preencha com os dados do seu projeto Firebase.
#     No Cloudflare Pages, configure as mesmas variáveis em:
#     Settings → Environment Variables

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=meu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=meu-projeto
VITE_FIREBASE_STORAGE_BUCKET=meu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abc123
